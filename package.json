{
  "name": "playwright-typescript-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "vite --config demo/vite.config.mts",
    "dev": "npm run demo",
    "build": "npm run typecheck && vite build --config demo/vite.config.mts",
    "preview": "vite preview --config demo/vite.config.mts",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --project=chromium --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "codegen": "playwright codegen --target=playwright-test",
    "codegen:demo": "playwright codegen --target=playwright-test http://127.0.0.1:3000",
    "browsers": "playwright install chromium",
    "browsers:all": "playwright install",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit && tsc --project demo/tsconfig.json",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
